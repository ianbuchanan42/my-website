<section class="mb-16">
  <h2 class="text-3xl font-bold mb-8">Contact Me</h2>
  
  <div class="max-w-2xl mx-auto">
    <%= helpers.form_with(url: contact_path, method: :post, class: "space-y-6", 
        data: { controller: "contact-form" }) do |f| %>
      <div>
        <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", required: true %>
      </div>
      
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
        <%= f.email_field :email, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", required: true %>
      </div>
      
      <div>
        <%= f.label :message, class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_area :message, rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", required: true %>
      </div>
      
      <%= f.submit "Send Message", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500", data: { contact_form_target: "submit" } %>
    <% end %>
  </div>

 
</section> 
